    "keywords": ["平滑到标题", "标题放大", "3倍放大", "镜头推进", "zoom in"],
    "promptExample": "镜头平滑移动到仓库 title，然后以 title 为中心放大 3 倍",
    "defaults": {"scaleFrom": 1, "scaleTo": 3, "origin": "repository-title", "focusDurationMs": 2500, "zoomDurationMs": 2500, "easing": "easeInOut"},
    "svg": "effect-catalog/svgs/camera-zoom.svg",
    "render": "camera-zoom",
    "githubInstruction": "使用真实 GitHub 录制，先将镜头平滑移动并锁定在仓库 title，再以 title 为中心连续放大到 3 倍；保持真实页面纹理清晰。",
    "sourceRequirement": "captured-page",
    "remotion": {"component": "CameraZoomToTitle", "input": "captured-page", "parameters": {"scaleFrom": "number", "scaleTo": "number", "origin": "repository-title", "focusDurationFrames": "number", "zoomDurationFrames": "number", "easing": "easing"}}
  },
  {
